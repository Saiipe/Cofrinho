{
  "name": "cofrinho",
  "private": true,
  "version": "1.0.0",
  "description": "Cofrinho — controle de despesas, receitas, orçamentos e contas. Local-first, PWA e Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "0.577.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
